{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["worker", "tests"],
  // UI component tests (.tsx) import DOM-lib frontend code from src/ — they
  // belong to the app project; excluding them here keeps the Worker DOM-free.
  "exclude": ["**/*.test.tsx"]
}
