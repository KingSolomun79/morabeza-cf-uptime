{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morabeza-cf-uptime",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-05",
  // Production exposure is custom-hostname ONLY (issue #28; PRD §29.3–4, §31):
  // no <name>.<subdomain>.workers.dev and no version-preview URLs, so every
  // app request crosses the Cloudflare Access gate on uptime.morabeza.digital.
  // /healthz is the one deliberate anonymous exception (PRD §8.2).
  "workers_dev": false,
  "preview_urls": false,
  // The single production Cron Trigger (issue #10; PRD §15.1): every monitor
  // interval derives its cadence from this one minute tick, in UTC.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "morabeza-cf-uptime-db",
      // Real database id — created by the owner in WEUR (issue #29; PRD §35).
      "database_id": "904168a3-1371-48e8-9c9e-8b9a105f7481",
      "migrations_dir": "db/migrations"
    }
  ],
  // Custom hostname (issue #29; PRD §35): attaching here means the FIRST
  // workflow deploy creates the domain itself — with workers_dev/preview_urls
  // off there is no other URL, so the post-deploy smoke step can run. Requires
  // the morabeza.digital zone on the same account; wrangler creates the DNS
  // record automatically. Cloudflare Access on this hostname is configured
  // separately (Zero Trust) and gates every path except /healthz.
  "routes": [
    {
      "pattern": "uptime.morabeza.digital",
      "custom_domain": true
    }
  ],
  "send_email": [
    {
      // Email Service send binding (issue #17; PRD §9.2). Provisioned for
      // real in #29 — the binding is valid config; sending fails loudly
      // (retry → DLQ) until the domain is onboarded (PRD §9.1).
      "name": "EMAIL"
    }
  ],
  // Production vars (issue #28; PRD §31). Local development overrides
  // APP_ORIGIN / APP_ACCESS_MODE via .dev.vars (see .dev.vars.example).
  // No secrets belong here (PRD §31): ACCESS_TEAM_DOMAIN / ACCESS_AUDIENCE
  // are owner actions in #29 (dashboard or `wrangler secret put` / deploy
  // --var), not repo config.
  "vars": {
    "APP_ORIGIN": "https://uptime.morabeza.digital",
    // Fail-closed auth contract (§8.4): production ships Access mode. The
    // runtime default when absent is "locked" (reject everything), so a
    // stripped var can never open the API.
    "APP_ACCESS_MODE": "access",
    // Deployment timezone contract (§31). The UI reads the §27.8 constant
    // (DISPLAY_TIMEZONE in src/lib/time-format.ts) — keep the two in sync.
    "APP_TIMEZONE": "Atlantic/Cape_Verde",
    "DEFAULT_FROM_EMAIL": "uptime@morabeza.digital",
    // Retention windows in days (issue #19; PRD §18): raw 7d / hourly 90d /
    // daily 730d (§18 defaults). Parsed by the shared parseRetentionDays.
    "RAW_CHECK_RETENTION_DAYS": "7",
    "HOURLY_RETENTION_DAYS": "90",
    "DAILY_RETENTION_DAYS": "730",
    // Build/version metadata for GET /api/system (issue #26). Base value;
    // the deploy workflow overrides it with `<pkg>+run-<n>-<sha>` via
    // `wrangler deploy --var` so every deployment is identifiable.
    "APP_VERSION": "0.1.0"
  },
  "queues": {
    "producers": [
      {
        "binding": "CHECK_QUEUE",
        "queue": "morabeza-cf-uptime-checks"
      }
    ],
    "consumers": [
      {
        "queue": "morabeza-cf-uptime-checks",
        "dead_letter_queue": "morabeza-cf-uptime-checks-dlq",
        "max_retries": 3
      },
      {
        "queue": "morabeza-cf-uptime-checks-dlq"
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true
    },
    // §31: traces with conservative head sampling (5%).
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  // Static assets (issue #21; same-unit deploy via the Vite/Cloudflare
  // pipeline). Client-side routes (e.g. email deep links /monitors/:id) fall
  // back to index.html; the API and /healthz ALWAYS hit the Worker so the
  // JSON envelope contracts (PRD §24, §38) are preserved. Security headers
  // for asset responses come from public/_headers; Worker-generated
  // responses carry them from worker/lib/security-headers.ts (PRD §29.11–14).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  }
}
// Final production configuration (issue #28; PRD §31); database_id filled and
// custom domain attached for #29 (PRD §35). Remaining provisioning — queues,
// Email Service, Access, deploy credentials — is the owner's HITL issue #29.
// No API tokens belong in this file (PRD §31).
//
// Local development: copy .dev.vars.example to .dev.vars — it overrides the
// production vars above with APP_ACCESS_MODE=local and a localhost APP_ORIGIN
// (PRD §7.1). Apply migrations with `pnpm db:migrate:local`. Config
// validation: `pnpm deploy:dry-run` (build + `wrangler deploy --dry-run`).
