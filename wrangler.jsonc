{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morabeza-cf-uptime",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-05",
  // The single production Cron Trigger (issue #10; PRD §15.1): every monitor
  // interval derives its cadence from this one minute tick, in UTC.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "morabeza-cf-uptime-db",
      "database_id": "OWNER_TO_FILL_AFTER_CREATION",
      "migrations_dir": "db/migrations"
    }
  ],
  "send_email": [
    {
      // Email Service send binding (issue #17; PRD §9.2). Provisioned for
      // real in #29 — placeholder is valid config for `wrangler dev` and
      // `wrangler deploy` once the domain is onboarded.
      "name": "EMAIL"
    }
  ],
  // Non-secret vars (issue #19; PRD §18 + §31 deploy example). Retention
  // windows in days; §18 defaults are raw 7d / hourly 90d / daily 730d.
  "vars": {
    "RAW_CHECK_RETENTION_DAYS": "7",
    "HOURLY_RETENTION_DAYS": "90",
    "DAILY_RETENTION_DAYS": "730"
  },
  "queues": {
    "producers": [
      {
        "binding": "CHECK_QUEUE",
        "queue": "morabeza-cf-uptime-checks"
      }
    ],
    "consumers": [
      {
        "queue": "morabeza-cf-uptime-checks",
        "dead_letter_queue": "morabeza-cf-uptime-checks-dlq",
        "max_retries": 3
      },
      {
        "queue": "morabeza-cf-uptime-checks-dlq"
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  // Static assets (issue #21; same-unit deploy via the Vite/Cloudflare
  // pipeline). Client-side routes (e.g. email deep links /monitors/:id) fall
  // back to index.html; the API and /healthz ALWAYS hit the Worker so the
  // JSON envelope contracts (PRD §24, §38) are preserved.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  }
}
// Scaffold placeholder (issue #1). Production bindings and settings — D1 (DB),
// Queues (CHECK_QUEUE + DLQ), Cron trigger, send_email (EMAIL), workers_dev/preview_urls
// disabled, non-secret vars — are finalized in issue #28 and provisioned in issue #29.
// No API tokens belong in this file (PRD §31).
//
// Local development: the DB binding resolves to a local SQLite database under
// .wrangler/state. Apply migrations with `pnpm db:migrate:local` (wrangler d1
// migrations apply ... --local). The real database_id is filled in at
// provisioning time (issue #29, PRD §35).
